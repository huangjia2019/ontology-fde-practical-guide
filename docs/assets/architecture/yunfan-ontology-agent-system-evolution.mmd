    classDef stop fill:#FCEBE6,stroke:#BD624B,color:#632E23;
    classDef record fill:#E9F4EC,stroke:#4E8A5D,color:#21452A;
    class S source;
    class O,R,D,W model;
    class N,H,F stop;
    class DR,E record;
